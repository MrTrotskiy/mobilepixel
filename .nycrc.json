{
  "all": true,
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "test/**",
    "node_modules/**",
    "lib/**"
  ],
  "extension": [
    ".ts"
  ],
  "require": [
    "ts-node/register"
  ],
  "reporter": [
    "text",
    "html",
    "lcov",
    "json-summary"
  ],
  "report-dir": "./coverage",
  "check-coverage": false,
  "lines": 10,
  "functions": 10,
  "branches": 10,
  "statements": 10,
  "per-file": false,
  "cache": false,
  "temp-dir": "./.nyc_output"
}



